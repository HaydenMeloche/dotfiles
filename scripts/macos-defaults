#!/usr/bin/env zsh
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  print 'Skipping macOS defaults: this is not a Mac.'
  exit 0
fi

# Appearance and keyboard behavior
defaults write -g AppleInterfaceStyle -string 'Dark'
defaults write -g ApplePressAndHoldEnabled -bool false
# Display: disable adaptive brightness.
defaults write com.apple.dpx.av AutoBrightness -bool false

# Mouse: use traditional scrolling direction rather than natural scrolling.
defaults write -g com.apple.swipescrolldirection -bool false

# Dock
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock tilesize -int 69
defaults write com.apple.dock show-recents -bool false

# Pinned Dock items, captured on 2026-08-31. Rebuild these lists so their order is
# consistent on a new Mac. Apps that are not installed will appear with a question-mark icon.
defaults delete com.apple.dock persistent-apps 2>/dev/null || true
defaults write com.apple.dock persistent-apps -array

add_dock_app() {
  local url="$1"
  defaults write com.apple.dock persistent-apps -array-add \
    "{tile-data={file-data={_CFURLString=\"${url}\"; _CFURLStringType=15;};}; tile-type=\"file-tile\";}"
}

add_dock_app 'file:///System/Applications/Apps.app/'
add_dock_app 'file:///Applications/Firefox.app/'
add_dock_app 'file:///Applications/Slack.app/'
add_dock_app 'file:///Applications/Ghostty.app/'
add_dock_app 'file:///System/Applications/Messages.app/'
add_dock_app 'file:///Applications/Docker.app/Contents/MacOS/Docker%20Desktop.app/'

defaults delete com.apple.dock persistent-others 2>/dev/null || true
defaults write com.apple.dock persistent-others -array \
  '{tile-data={arrangement=2; displayas=0; showas=1; file-data={_CFURLString="file:///Users/hayden/Downloads/"; _CFURLStringType=15;};}; tile-type="directory-tile";}'

# Finder
defaults write com.apple.finder FXPreferredViewStyle -string 'Nlsv'
defaults write com.apple.finder ShowStatusBar -bool false
defaults write com.apple.finder FXRemoveOldTrashItems -bool true

# Trackpads: keep physical click rather than tap-to-click.
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool false
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool false

# Reload the affected services without requiring a sign-out.
killall Dock 2>/dev/null || true
killall Finder 2>/dev/null || true
