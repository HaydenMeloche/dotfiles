#!/usr/bin/env zsh
set -euo pipefail

bash_path="$(brew --prefix bash)/bin/bash"
if [[ ! -x "$bash_path" ]]; then
  print 'Homebrew Bash is required for SDKMAN but was not found.' >&2
  exit 1
fi

"$bash_path" -s <<'BASH'
set -eo pipefail

if [[ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  curl -s https://get.sdkman.io | bash
fi

source "$HOME/.sdkman/bin/sdkman-init.sh"

for candidate in 'java 21.0.3-zulu' 'gradle 7.4' 'kotlin 1.6.10'; do
  read -r name version <<< "$candidate"
  if ! sdk list "$name" | grep -Fq "$version"; then
    printf 'SDKMAN does not offer %s %s; skipping it.\n' "$name" "$version"
    continue
  fi
  if [[ ! -d "$SDKMAN_DIR/candidates/$name/$version" ]]; then
    sdk install "$name" "$version"
  fi
  sdk default "$name" "$version"
done
BASH
